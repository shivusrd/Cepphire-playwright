<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CepHire Complete Test Suite" 
       parallel="false" 
       thread-count="1" 
       verbose="2" 
       configfailurepolicy="continue">
    
    <!-- Test Suite Parameters -->
    <parameter name="browser" value="chromium"/>
    <parameter name="headless" value="false"/>
    
    <!-- Listeners -->
    <listeners>
        <listener class-name="com.cepphire.listeners.TestListener"/>
    </listeners>
    
    <!-- ==================== LOGIN TESTS ==================== -->
    
    <test name="Valid Login Test" enabled="true">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="login"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testValidLoginFlow"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Invalid Login Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="login"/>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testInvalidLoginFlow"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="OAuth Buttons Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="login"/>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testOAuthButtons"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- ==================== DASHBOARD TESTS ==================== -->
    
    <test name="Dashboard Navigation Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="dashboard"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testDashboardAccess"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Candidates Tab Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="dashboard"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testCandidatesTab"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Jobs Tab Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="dashboard"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testJobsTab"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Search Functionality Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="dashboard"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testSearchFunctionality"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- ==================== NAVIGATION TESTS ==================== -->
    
    <test name="Sidebar Navigation Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="navigation"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testSidebarNavigation"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Logout Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="navigation"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testLogoutFunctionality"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- ==================== RESPONSIVE TESTS ==================== -->
    
    <test name="Mobile Responsive Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="responsive"/>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testMobileResponsive"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <test name="Tablet Responsive Test" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="responsive"/>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest">
                <methods>
                    <include name="testMobileResponsive"/>
                </methods>
            </class>
        </classes>
    </test>
    
    <!-- ==================== COMBINED TESTS ==================== -->
    
    <!-- Smoke Tests Only -->
    <test name="Smoke Tests Suite" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest"/>
        </classes>
    </test>
    
    <!-- All Login Tests -->
    <test name="All Login Tests" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="login"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest"/>
        </classes>
    </test>
    
    <!-- All Dashboard Tests -->
    <test name="All Dashboard Tests" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="dashboard"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest"/>
        </classes>
    </test>
    
    <!-- All Navigation Tests -->
    <test name="All Navigation Tests" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="navigation"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest"/>
        </classes>
    </test>
    
    <!-- All Responsive Tests -->
    <test name="All Responsive Tests" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="responsive"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest"/>
        </classes>
    </test>
    
    <!-- All Tests (Complete Suite) -->
    <test name="Complete Test Suite" enabled="false">
        <parameter name="browser" value="chromium"/>
        <parameter name="headless" value="false"/>
        <groups>
            <run>
                <include name="login"/>
                <include name="dashboard"/>
                <include name="navigation"/>
                <include name="responsive"/>
            </run>
        </groups>
        <classes>
            <class name="com.cepphire.tests.CepHireLoginFlowTest"/>
        </classes>
    </test>
    
</suite>
